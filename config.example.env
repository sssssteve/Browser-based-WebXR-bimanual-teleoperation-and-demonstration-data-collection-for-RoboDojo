# Copy this file to config.env, then adjust paths for the deployment machine.
# PROJECT is defined by the launch scripts as this package directory.

ROBODOJO_ROOT="${PROJECT}/external/RoboDojo"
ISAACLAB_ROOT="${ROBODOJO_ROOT}/third_party/IsaacLab"
ROBODOJO_OUTPUT="${PROJECT}/data"

# Leave empty when the current shell already uses RoboDojo's Python environment.
ROBODOJO_CONDA_ENV="RoboDojo"
ROBODOJO_DEVICE="cuda:0"
ROBODOJO_PORT="8443"

# Optional. When empty, start_desktop.sh searches PATH for adb.
ROBODOJO_ADB=""
